# ============================================================================
# Vertical Builders & Commercial — website + Vertical Ops (CRM + Compliance)
# ----------------------------------------------------------------------------
# Copy to .env.local for development. In production set these in Vercel under
# Project → Settings → Environment Variables. Never commit real values.
#
# The PUBLIC MARKETING SITE works with none of these set. Only /ops and the
# vendor upload portal need Supabase.
# ============================================================================

# ── Public URLs (not secrets) ───────────────────────────────────────────────
# Drives canonicals, OG tags, sitemap, schema, and the absolute links inside
# renewal emails.
NEXT_PUBLIC_SITE_URL=https://www.verticalbuildersandcommercial.com

# Where Vertical Ops is reachable. If the CRM lives on the same domain as the
# website (the default — /ops), set this to the same value as SITE_URL.
# If you later move it to crm.verticalbuildersandcommercial.com, change it here.
NEXT_PUBLIC_CRM_URL=https://www.verticalbuildersandcommercial.com

# ── Supabase (required for Vertical Ops) ────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-side only — bypasses Row Level Security.
# Used by exactly four flows: public lead intake, the vendor upload portal, the
# daily reminder cron, and signed-URL/audit-package generation.
# If this ever leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email via Resend (optional — everything degrades gracefully without it) ─
# https://resend.com → API keys. Verify the sending domain first.
# Without a key: leads are still saved, renewal links are still generated (copy
# them from the UI), and reminders are recorded in the notification log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@verticalbc.com
LEAD_NOTIFICATION_EMAIL=Office@verticalbc.com

# ── Daily expiration reminders ──────────────────────────────────────────────
# REQUIRED for the cron job to run at all — without it the endpoint refuses.
# Generate one: openssl rand -base64 32
# Vercel Cron sends it automatically as "Authorization: Bearer <value>".
CRON_SECRET=

# ── Cross-app lead intake (optional) ────────────────────────────────────────
# Only needed if the public website is ever deployed separately from the CRM.
# When set, /api/public/leads requires the header x-vbc-form-secret.
# Leave BLANK for the default single-app deployment.
PUBLIC_FORM_SHARED_SECRET=

# ── AI Enhanced (OPTIONAL — the product is fully usable without it) ─────────
# LEAVE THIS BLANK and Vertical Ops runs in Smart Ops mode: the assistant still
# answers built-in operational questions from live CRM data, the dashboard and
# audit briefs still generate, the calculator and communication templates still
# work, and leads can still be structured from labelled notes. No external AI
# provider is contacted and nothing is billed per question.
# See docs/SMART_OPS.md.
#
# SET THIS to activate AI Enhanced, which adds:
#   · free-form questions in the assistant (anything not a built-in command)
#   · messy-prose lead structuring
#   · custom message writing
#   · COI document extraction  ← the only feature with no built-in equivalent,
#                                because reading a scanned certificate needs a
#                                vision model. Manual entry stays available.
#   · optional AI rewording of the two briefs
#
# USAGE IS BILLED BY THE AI PROVIDER. Set a monthly cap in the OpenAI dashboard.
# The same key also powers the website chat assistant (/api/chat) and AI
# estimate drafting.
#
# SECRET. Read on the server only — it is never sent to the browser, never
# written to the database, and never displayed in Settings.
OPENAI_API_KEY=

# ── Legacy (kept so the old /api/quote path still works) ────────────────────
LEAD_TO_EMAIL=Office@verticalbc.com
LEAD_FROM_EMAIL=leads@verticalbc.com

# ============================================================================
# PHASE 2 — estimating, measurements, payments
# ----------------------------------------------------------------------------
# Everything below is OPTIONAL. With none of it set, Phase 2 still works:
# estimates are built by hand from the pricebook, measurements are typed in or
# uploaded as a report, and payments are recorded manually by the office.
# Each feature reports its own configuration state in Settings, so nobody has
# to guess why a button is missing.
# ============================================================================

# ── AI estimate drafting (optional) ─────────────────────────────────────────
# Uses OPENAI_API_KEY above. This only picks the model.
# The AI can never set a price: unit prices come from the pricebook by id, and
# any line without pricebook backing is flagged and cannot be sent.
OPENAI_ESTIMATE_MODEL=gpt-4o

# ── Vertical Ops AI Enhanced model (Phase 3, optional) ──────────────────────
# Ignored entirely when OPENAI_API_KEY is blank — Smart Ops uses no model.
#
# Uses OPENAI_API_KEY above. This only picks the model for the operations AI —
# free-form assistant answers, lead structuring, COI extraction and the two
# brief rewordings. It is deliberately separate from OPENAI_ESTIMATE_MODEL so
# the estimate model can be tuned without changing what the assistant costs.
#
# Default gpt-4o-mini. COI extraction needs a vision-capable model; if you set
# something without vision, extraction will fail cleanly and the manual entry
# path stays available.
OPENAI_OPS_MODEL=gpt-4o-mini

# NOT IMPLEMENTED — recorded here so it is not mistaken for a working control.
# Per-user daily spend caps are a Phase 3B item (see docs/PHASE_3_AI.md).
# Today, cost is bounded three ways: Smart Ops answers the common questions
# before they ever reach the model; the per-request limits in
# lib/ops/ai/guardrails.ts (message length, conversation turns, tool calls,
# rows per tool, output tokens); and the feature switches in
# Settings → Assistant. Set a hard monthly cap in the OpenAI dashboard as well.
#
# To see what the AI layer is actually costing:
#   select feature, count(*) from ai_runs where mode = 'ai_enhanced' group by 1;
# OPENAI_OPS_DAILY_USER_LIMIT=

# ── Roof measurements (optional) ────────────────────────────────────────────
# Which source the "Order measurement" button uses. One of:
#   manual     — typed in or uploaded report (default, always available)
#   eagleview  — needs the two EAGLEVIEW_ values below
#   nearmap    — needs NEARMAP_API_KEY below
# Also settable in Settings → Measurements, which overrides this.
ROOF_MEASUREMENT_PROVIDER=manual

# EagleView API credentials. NOTE: this adapter has been written against
# EagleView's documented API but has NOT been exercised against a live account.
# Verify field names against your own first report before trusting quantities.
EAGLEVIEW_CLIENT_ID=
EAGLEVIEW_CLIENT_SECRET=

# Optional EagleView overrides. Both have working defaults — set them only if
# your account needs a different endpoint or report product.
#   EAGLEVIEW_REPORT_TYPE selects WHICH REPORT IS ORDERED, and reports cost
#   money, so confirm the number against your EagleView contract before
#   changing it. Default 1.
# EAGLEVIEW_API_BASE=https://webservices.eagleview.com
# EAGLEVIEW_REPORT_TYPE=1

# Nearmap API key. Same caveat as EagleView — adapter written, not live-tested.
NEARMAP_API_KEY=

# Optional Nearmap endpoint override. Default shown.
# NEARMAP_API_BASE=https://api.nearmap.com

# Static aerial preview on the estimate screen. A picture only — aerial imagery
# does not contain roof geometry and is never used to derive measurements.
GOOGLE_MAPS_API_KEY=

# ── Online payments via Stripe (optional) ───────────────────────────────────
# Card and bank details are entered on Stripe's hosted checkout page, never in
# Vertical Ops. Without these, invoices still work and payments are recorded by
# hand (check, cash, card taken elsewhere).
#
# All three are required before the Pay button appears:
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From Stripe → Developers → Webhooks, after adding the endpoint
#   POST https://<your-domain>/api/webhooks/stripe
# with events: checkout.session.completed,
#              checkout.session.async_payment_succeeded,
#              checkout.session.async_payment_failed,
#              payment_intent.succeeded, payment_intent.payment_failed,
#              charge.refunded
# A payment is only ever recorded from a verified webhook. The browser coming
# back from checkout is never treated as proof.
STRIPE_WEBHOOK_SECRET=
